{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app6",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "2ee9b022-6517-4826-adb7-1c9cdcc0cd4a","database_name": "web-app6" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "9dd3fdfaf58b49bbad3d2cf00d8b6411" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
